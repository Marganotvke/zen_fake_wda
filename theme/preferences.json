    "options": [
      { "label": "Left", "value": "left" },
      { "label": "Center", "value": "center" },
      { "label": "Right", "value": "right" }
    ]
  },
  {
    "property": "zen.fake_transparency.acrylic_blur",
    "label": "Acrylic blur on wallpaper and popups",
    "type": "checkbox",
    "defaultValue": true,
    "disabledOn": ["macos", "linux"]
