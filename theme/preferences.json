    "type": "checkbox",
    "defaultValue": false,
    "disabledOn": ["macos", "linux"]
  },
  {
    "property": "zen.fake_transparency.background_mode",
    "label": "Background mode",
    "type": "dropdown",
    "defaultValue": "static",
    "disabledOn": ["macos", "linux"],
    "options": [
      { "label": "Static wallpaper (CSS)", "value": "static" },
      { "label": "Live HTML/WebGL embed", "value": "live" },
      { "label": "Live desktop capture", "value": "desktop" }
    ]
  },
  {
    "property": "zen.fake_transparency.wallpaper_url",
